    <string name="preset_parasitic_label">Отключить все паразитные параметры</string>
    <string name="preset_parasitic_hint">Отключает все ненужные настройки, которые затрудняют геймплей, снижают производительность или просто удалены из игры, но остались в меню (ненужные блики, размытия, уведомления, анимации и т.д.)</string>
    <string name="preset_legs_rendering_label">Отключить отображение ног</string>
    <string name="preset_legs_rendering_hint">Отключает отображение ног персонажа от первого лица, помогая целиться вниз.</string>
    <string name="preset_camera_shake_label">Уменьшить тряску камеры</string>
    <string name="preset_camera_shake_hint">Минимизирует тряску камеры при беге, стрельбе, взрывах и получении урона.</string>
    <string name="preset_tree_marker_label">Улучшить видимость крестиков на деревьях</string>
    <string name="preset_tree_marker_hint">Меняет цвет отображения маркеров на деревьях на более контрастный.</string>
    <string name="preset_occlusion_culling_label">Отключить безопасный режим механизма отсечению окклюзии</string>
    <string name="preset_occlusion_culling_hint">Проверка, что безопасный режим отсечения окклюзии, который очень сильно снижает FPS, отключен.</string>
    <string name="preset_gibs_label">Полностью отключить обломки</string>
    <string name="preset_gibs_hint">Полностью отключает обломки при разрушении сооружений и объектов. Звуки разрушений при этом сохраняются.</string>
    <string name="preset_legs_deformation_label">Отключить деформацию ног</string>
    <string name="preset_legs_deformation_hint">Возвращает старую анимацию ног персонажа, которая не подстраивается под рельеф. Может помочь в PVP и немного снизить нагрузку на ПК.</string>
    <string name="preset_strobe_lights_label">Отключить стробоскопы</string>
    <string name="preset_strobe_lights_hint">Полностью отключает стробоскопы в игре, оставляя только звук их работы. Может сильно повысить FPS, если рядом несколько стробоскопов.</string>
    <string name="preset_held_item_size_label">Уменьшить предмет в руках</string>
    <string name="preset_held_item_size_hint">Делает оружие и предметы в руках персонажа меньше. Функция работает только если угол обзора установлен выше 70.</string>
    <string name="preset_event_notifications_label">Вернуть текстовые уведомления об ивентах</string>
    <string name="preset_event_notifications_hint">Возвращает текстовые уведомления о старте ивентов, таких как появление на карте карго, патрульного вертолета, чинука и т.п.</string>
    <string name="preset_autocraft_delay_label">Убрать задержку в меню автокрафта</string>
    <string name="preset_autocraft_delay_hint">Отключает небольшое провисание интерфейса при попытке скрафтить предмет через меню быстрого крафта.</string>
    <string name="preset_sleeping_bag_label">Снизить задержку при удалении спальников</string>
    <string name="preset_sleeping_bag_hint">Твик позволяет практически мгновенно удалять спальники, кликнув на крестик на карте.</string>
    <string name="preset_f8_map_info_label">Добавить информацию о карте в меню F8</string>
    <string name="preset_f8_map_info_hint">Добавляет информацию о типе, размере и сиде карты в меню отладки F8. У администраторов серверов также отображаются коорлинаты персонажа.</string>
    <string name="preset_error_overlay_label">Отключить отображение клиентских ошибок</string>
    <string name="preset_error_overlay_hint">Полностью отключает надоедливые красные ошибки в углу экрана.</string>
    <string name="preset_admin_gestures_label">Добавить админские жесты в игровое меню</string>
    <string name="preset_admin_gestures_hint">Добавляет скрытые анимации в меню настройки жестов. Эти анимации работают только при наличии админки на сервере.</string>
    <string name="preset_skin_sorting_label">Удобная сортировка скинов</string>
    <string name="preset_skin_sorting_hint">Сортирует скины в меню крафта по дате использования.</string>
    <string name="preset_enlarged_console_label">Увеличенная консоль</string>
    <string name="preset_enlarged_console_hint">Увеличивает размер шрифта в консоли.</string>
    <string name="preset_radial_menu_label">Снизить задержку вызова радиального меню</string>
    <string name="preset_radial_menu_hint">Немного ускоряет появление радиального меню при зажатии кнопки взаимодействия. Может быть не привычно. Не рекомендуется игрокам с низким FPS.</string>
    <string name="preset_left_hand_label">Режим левой руки</string>
    <string name="preset_left_hand_hint">Переносит оружие и предметы в левую руку персонажа</string>

